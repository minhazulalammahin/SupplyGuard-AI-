# SupplyGuard AI - Streamlit Secrets Configuration Template
# For Streamlit Community Cloud: Paste these keys into the "Secrets" field in your App Settings.
# For Local Development: Copy this file to .streamlit/secrets.toml and enter your key.

GEMINI_API_KEY = "your_actual_gemini_api_key_here"
GEMINI_MODEL = "gemini-2.5-flash"

